# Copy to .env and adjust. All values are optional (defaults shown).

# LLM backend: "ollama" (talk to Ollama directly) or "openai" (any
# OpenAI-compatible endpoint, e.g. the LiteLLM gateway from docker-compose.yml)
LLM_PROVIDER=ollama
LLM_TEMPERATURE=0.2

# ... when LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:18080
OLLAMA_MODEL=llama3.1
LLM_NUM_CTX=8192

# ... when LLM_PROVIDER=openai (model name as exposed by the gateway)
LLM_BASE_URL=http://localhost:4000/v1
LLM_MODEL=llama3.1-8b
LLM_API_KEY=

# Docker Compose only: key of the LiteLLM gateway (change it on a shared host)
LITELLM_MASTER_KEY=sk-local-dev-change-me

# Embeddings: changing the model requires `python ingest.py` (auto full rebuild).
# A stronger option with a 512-token window: intfloat/multilingual-e5-small
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Retrieval
TOP_K=8
CANDIDATE_K=25
CHUNK_SIZE=450
CHUNK_OVERLAP=80

# Conversation / web
MAX_HISTORY_TURNS=6
SESSION_TTL_SECONDS=7200
MAX_SESSIONS=1000
MAX_QUESTION_LENGTH=500
RATE_LIMIT=20/minute
COOKIE_SECURE=false

# Logging
DEBUG_RETRIEVAL=false
LOG_LEVEL=INFO

# Disable Chroma's anonymous telemetry (also silences its noisy log errors)
ANONYMIZED_TELEMETRY=False
